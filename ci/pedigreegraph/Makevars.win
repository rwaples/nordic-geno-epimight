# Trial Windows build of pedigreegraph's Rust crate, overlaid on the pinned source by
# .github/workflows/windows.yml. Once it works it moves to pedigree-graph's r/src/.
#
# R on Windows compiles and links with MinGW gcc, so the crate is built for the GNU target
# (rust-std-x86_64-pc-windows-gnu), whatever the host toolchain is. cargo is found on PATH:
# make's $(PATH) is in Windows form, which the sh recipes can't extend with a Unix path.
TARGET = x86_64-pc-windows-gnu
TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/release
STATLIB = $(LIBDIR)/libpedigreegraph.a
PKG_LIBS = -L$(LIBDIR) -lpedigreegraph -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

all: $(SHLIB)

$(SHLIB): $(STATLIB)

$(STATLIB):
	@echo "using $$(rustc --version)"
	@echo "using $$(cargo --version)"
	cargo build -j 2 --lib --release --target $(TARGET) \
	  $${PG_CARGO_FEATURES:+--features "$$PG_CARGO_FEATURES"} \
	  --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR)

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS)

.PHONY: all clean $(STATLIB)
